<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml = the "passport" of your app.
    It declares:
      - What permissions the app needs (internet, storage, etc.)
      - What screens (Activities) exist
      - Which screen to show first
      - App name and icon
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- We need internet to download the model on first launch -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalLLM">

        <!--
            MainActivity is our one and only screen.
            android:exported="true" means it can be launched from the home screen.
            The intent-filter below marks it as the LAUNCHER (the screen that opens when you tap the icon).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Model library screen, opened when user taps "Models" button -->
        <activity
            android:name=".ModelLibraryActivity"
            android:exported="false" />

    </application>

</manifest>
