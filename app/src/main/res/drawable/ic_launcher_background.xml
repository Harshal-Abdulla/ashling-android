<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background. A diagonal gradient rather than a flat fill —
     a single colour reads as a placeholder at launcher size. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="11" android:startY="0"
                android:endX="97" android:endY="108"
                android:type="linear">
                <item android:offset="0.0"  android:color="#FF1E1440"/>
                <item android:offset="0.48" android:color="#FF4B32A8"/>
                <item android:offset="1.0"  android:color="#FF7C5CF0"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Light from the top left, so the surface has a direction. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:centerX="28" android:centerY="17" android:gradientRadius="76"
                android:type="radial">
                <item android:offset="0.0" android:color="#42FFFFFF"/>
                <item android:offset="0.6" android:color="#0AFFFFFF"/>
                <item android:offset="1.0" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
